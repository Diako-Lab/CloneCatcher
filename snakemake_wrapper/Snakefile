# =============================================================================
# CloneCatcher
#
# T cell receptor repertoire reconstruction, clonal expansion testing, and
# neoantigen specificity linkage from bulk or single-cell sequencing.
#
# Two frontends emit the same clonotype schema; one backend consumes it. The
# mode is set by config["input_mode"] and decides which frontend enters the
# DAG. Only one ever does.
#
# All output goes to config["output_dir"], a project-specific working directory
# outside this repository.
# =============================================================================

import pickle
import sys
from pathlib import Path

configfile: "config.yaml"


# --- paths -------------------------------------------------------------------

OUT = Path(config["output_dir"])
MODE = config["input_mode"]

if MODE not in ("bulk", "single_cell"):
    raise ValueError(
        f"input_mode must be 'bulk' or 'single_cell', got {MODE!r}"
    )

# One environment per input type. Both carry the full stack for their mode.
ENV = "envs/bulk.yaml" if MODE == "bulk" else "envs/scRNA.yaml"

# One exception. tcrdist3 does not support pandas 2.x, and both environments
# above pin pandas 2.2.3 to match ClusterCatcher's anndata 0.12.6. The
# specificity stage therefore runs isolated, exchanging TSV with the rest of
# the pipeline so the version skew stays contained.
TCRDIST_ENV = "envs/tcrdist3.yaml"

MODULES = config.get("modules", {})


# --- sample resolution -------------------------------------------------------

def declares_vdj(sample):
    """True if a sample's cellranger multi config declares a VDJ library.

    An upstream run may legitimately contain samples with no TCR library --
    a series mixing 3' and 5' chemistry will, since 3' libraries cannot
    produce VDJ data. Those samples are skipped rather than treated as a
    failure.
    """
    cr = Path(config.get("cellranger_dir", ""))
    candidates = [
        cr / "multi_runs" / f"{sample}_multi_config.csv",
        cr / "multi_runs" / sample / "outs" / "config.csv",
    ]
    for path in candidates:
        if not path.exists():
            continue
        in_block = False
        for line in path.read_text().splitlines():
            line = line.strip()
            if line.startswith("["):
                in_block = line.lower().startswith("[libraries]")
                continue
            if not in_block or not line or line.startswith("fastq_id"):
                continue
            parts = [p.strip() for p in line.split(",")]
            if len(parts) >= 3 and "vdj" in parts[2].lower():
                return True
        return False
    # No config found. Fall back to the published output path.
    return (
        cr / "multi_runs" / sample / "outs" / "per_sample_outs" / sample / "vdj_t"
    ).is_dir()


def resolve_samples():
    """Sample IDs for this run.

    bulk        -- from the sample pickle produced by `CloneCatcher
                   sample-information`.
    single_cell -- from the upstream ClusterCatcher AnnData, so the IDs match
                   the barcode namespace rather than being re-derived from
                   accessions or directory names, then filtered to those
                   carrying a VDJ library.
    """
    if MODE == "bulk":
        with open(config["sample_info"], "rb") as fh:
            return sorted(pickle.load(fh).keys())

    explicit = config.get("samples")
    if explicit:
        candidates = sorted(explicit)
    else:
        import anndata as ad
        cc = Path(config["clustercatcher_run_dir"])
        candidates = None
        for rel in (
            "signatures/adata_final.h5ad",
            "adata_final.h5ad",
            "dysregulation/adata_cancer_detected.h5ad",
            "viral_integration/adata_viral_integrated.h5ad",
            "annotation/adata_annotated.h5ad",
        ):
            path = cc / rel
            if path.exists():
                adata = ad.read_h5ad(path, backed="r")
                candidates = sorted(adata.obs["sample_id"].astype(str).unique())
                break
        if candidates is None:
            raise FileNotFoundError(
                f"No ClusterCatcher AnnData under {cc}. Set `samples` in the "
                "config to override, or point clustercatcher_run_dir at a "
                "completed run."
            )

    kept = [s for s in candidates if declares_vdj(s)]
    skipped = [s for s in candidates if s not in kept]

    if skipped:
        print(
            f"CloneCatcher: skipping {len(skipped)} sample(s) with no VDJ "
            f"library: {', '.join(skipped)}",
            file=sys.stderr,
        )
    if not kept:
        raise ValueError(
            "No sample in this run declares a VDJ library. single_cell mode "
            "needs cellranger multi output with a VDJ-T library. Check "
            "cellranger_dir, or run `CloneCatcher inspect-barcodes` for a "
            "per-sample report."
        )
    return kept


SAMPLES = resolve_samples()


# --- targets -----------------------------------------------------------------

def target_files(wildcards=None):
    """Final outputs for this run. Branches on mode so the unused frontend
    never enters the DAG."""
    targets = [
        OUT / "tcr" / "clonotypes_by_sample.tsv",
        OUT / "master_summary.yaml",
    ]

    if MODE == "single_cell":
        targets += [
            OUT / "tcr" / "clonotypes_by_cell.tsv",
            OUT / "tcr" / "barcode_join_report.tsv",
        ]

    if MODULES.get("repertoire", True):
        targets.append(OUT / "repertoire" / "repertoire_stats.tsv")
    if MODULES.get("expansion", True):
        targets.append(OUT / "expansion" / "expansion_results.tsv")
    if MODULES.get("specificity", True):
        targets.append(OUT / "specificity" / "specificity_clusters.tsv")
    if MODE == "single_cell" and MODULES.get("integration", True):
        targets.append(OUT / "integration" / "adata_tcr.h5ad")

    return [str(t) for t in targets]


rule all:
    input:
        target_files


# =============================================================================
# Module 1a -- TRUST4 reconstruction  (bulk)
# =============================================================================

rule trust4_reconstruct:
    input:
        sample_info=lambda w: config["sample_info"],
    output:
        clonotypes=OUT / "tcr" / "trust4" / "{sample}" / "clonotypes.tsv",
    params:
        imgt=lambda w: config["trust4"]["imgt_reference"],
        min_abundance=lambda w: config["trust4"].get("min_abundance", 2),
        chains=lambda w: ",".join(config["trust4"].get("chains", ["TRA", "TRB"])),
        outdir=lambda w: str(OUT / "tcr" / "trust4" / w.sample),
    log:
        OUT / "logs" / "tcr" / "trust4_{sample}.log",
    threads: config.get("threads", 8)
    conda:
        ENV
    script:
        "scripts/trust4_reconstruct.py"


# =============================================================================
# Module 1b -- VDJ parse  (single_cell)
# =============================================================================

rule cellranger_vdj_parse:
    output:
        contigs=OUT / "tcr" / "vdj" / "{sample}" / "contigs.tsv",
    params:
        cellranger_dir=lambda w: config["cellranger_dir"],
        sample=lambda w: w.sample,
        require_productive=lambda w: config["vdj"].get("require_productive", True),
        require_paired=lambda w: config["vdj"].get("require_paired", False),
        min_umis=lambda w: config["vdj"].get("min_umis", 2),
    log:
        OUT / "logs" / "tcr" / "vdj_parse_{sample}.log",
    conda:
        ENV
    script:
        "scripts/cellranger_vdj_parse.py"


# =============================================================================
# Module 2 -- Barcode namespace  (single_cell)
#
# Promotes bare CellRanger VDJ barcodes into ClusterCatcher's canonical
# namespace and asserts the join rate. This rule raises on zero overlap rather
# than writing an empty table.
# =============================================================================

rule barcode_namespace:
    input:
        contigs=expand(
            str(OUT / "tcr" / "vdj" / "{sample}" / "contigs.tsv"),
            sample=SAMPLES,
        ),
    output:
        # Intermediate. Clonotype identity is assigned downstream in
        # collapse_to_sample, which emits clonotypes_by_cell.tsv with IDs that
        # join to clonotypes_by_sample.tsv.
        cells=OUT / "tcr" / "cells_namespaced.tsv",
        report=OUT / "tcr" / "barcode_join_report.tsv",
    params:
        clustercatcher_run_dir=lambda w: config["clustercatcher_run_dir"],
        min_join_rate=lambda w: config["barcode"].get("min_join_rate", 0.40),
        on_unmapped=lambda w: config["barcode"].get("on_unmapped", "drop"),
        samples=SAMPLES,
    log:
        OUT / "logs" / "tcr" / "barcode_namespace.log",
    conda:
        ENV
    script:
        "scripts/barcode_namespace.py"


# =============================================================================
# Shared schema -- clonotypes_by_sample.tsv
#
# Both frontends converge here. Everything downstream reads this file and
# nothing else, which is what keeps the two modes from drifting apart.
# =============================================================================

# Two definitions rather than one with conditional outputs, because the cell
# table exists only in single_cell mode and Snakemake outputs are static per
# rule. Only one is ever defined, since MODE is fixed for a run.

if MODE == "single_cell":

    rule collapse_to_sample:
        input:
            OUT / "tcr" / "cells_namespaced.tsv",
        output:
            by_sample=OUT / "tcr" / "clonotypes_by_sample.tsv",
            by_cell=OUT / "tcr" / "clonotypes_by_cell.tsv",
        params:
            mode=MODE,
            samples=SAMPLES,
            sample_info=lambda w: config.get("sample_info"),
            expansion_threshold=lambda w: config["expansion"].get(
                "expansion_threshold", 0.01
            ),
        log:
            OUT / "logs" / "tcr" / "collapse_to_sample.log",
        conda:
            ENV
        script:
            "scripts/collapse_to_sample.py"

else:

    rule collapse_to_sample:
        input:
            expand(
                str(OUT / "tcr" / "trust4" / "{sample}" / "clonotypes.tsv"),
                sample=SAMPLES,
            ),
        output:
            by_sample=OUT / "tcr" / "clonotypes_by_sample.tsv",
        params:
            mode=MODE,
            samples=SAMPLES,
            sample_info=lambda w: config.get("sample_info"),
            expansion_threshold=lambda w: config["expansion"].get(
                "expansion_threshold", 0.01
            ),
        log:
            OUT / "logs" / "tcr" / "collapse_to_sample.log",
        conda:
            ENV
        script:
            "scripts/collapse_to_sample.py"


# =============================================================================
# Module 3 -- Repertoire statistics  (Immunarch)
# =============================================================================

rule repertoire_stats:
    input:
        by_sample=OUT / "tcr" / "clonotypes_by_sample.tsv",
    output:
        stats=OUT / "repertoire" / "repertoire_stats.tsv",
        figdir=directory(OUT / "repertoire" / "figures"),
    params:
        diversity_methods=lambda w: config["repertoire"].get(
            "diversity_methods", ["chao1", "shannon", "gini"]
        ),
        top_n_clones=lambda w: config["repertoire"].get("top_n_clones", 20),
    log:
        OUT / "logs" / "repertoire" / "repertoire_stats.log",
    threads: config.get("threads", 8)
    conda:
        ENV
    script:
        "scripts/repertoire_stats.py"


# =============================================================================
# Module 4 -- Expansion
#
# With expansion.contrast null, reports per-sample expanded-clone calls with no
# hypothesis test. With a contrast declared, runs the beta-binomial differential
# test between conditions within the blocking variable.
# =============================================================================

rule expansion_test:
    input:
        by_sample=OUT / "tcr" / "clonotypes_by_sample.tsv",
    output:
        results=OUT / "expansion" / "expansion_results.tsv",
        figdir=directory(OUT / "expansion" / "figures"),
    params:
        contrast=lambda w: config["expansion"].get("contrast"),
        fdr=lambda w: config["expansion"].get("fdr", 0.05),
        expansion_threshold=lambda w: config["expansion"].get(
            "expansion_threshold", 0.01
        ),
    log:
        OUT / "logs" / "expansion" / "expansion_test.log",
    conda:
        ENV
    script:
        "scripts/expansion_test.py"


# =============================================================================
# Module 5 -- Specificity  (tcrdist3)
# =============================================================================

rule tcrdist_cluster:
    input:
        by_sample=OUT / "tcr" / "clonotypes_by_sample.tsv",
    output:
        clusters=OUT / "specificity" / "specificity_clusters.tsv",
        hits=OUT / "specificity" / "database_hits.tsv",
        figdir=directory(OUT / "specificity" / "figures"),
    params:
        method=lambda w: config["specificity"].get("method", "tcrdist3"),
        radius=lambda w: config["specificity"].get("radius", 50),
        reference_dbs=lambda w: config["specificity"].get(
            "reference_dbs", ["vdjdb", "mcpas"]
        ),
        resources_dir=lambda w: config.get("resources_dir", "resources"),
    log:
        OUT / "logs" / "specificity" / "tcrdist_cluster.log",
    threads: config.get("threads", 8)
    conda:
        TCRDIST_ENV
    script:
        "scripts/tcrdist_cluster.py"


# =============================================================================
# Module 6 -- ClusterCatcher integration  (single_cell)
# =============================================================================

rule join_clustercatcher:
    input:
        by_cell=OUT / "tcr" / "clonotypes_by_cell.tsv",
        by_sample=OUT / "tcr" / "clonotypes_by_sample.tsv",
    output:
        adata=OUT / "integration" / "adata_tcr.h5ad",
    params:
        clustercatcher_run_dir=lambda w: config["clustercatcher_run_dir"],
        min_join_rate=lambda w: config["barcode"].get("min_join_rate", 0.40),
    log:
        OUT / "logs" / "integration" / "join_clustercatcher.log",
    conda:
        ENV
    script:
        "scripts/join_clustercatcher.py"


# =============================================================================
# Module 7 -- Summary
# =============================================================================

rule generate_summary:
    input:
        target_files_except_summary=lambda w: [
            t for t in target_files() if not t.endswith("master_summary.yaml")
        ],
    output:
        summary=OUT / "master_summary.yaml",
    params:
        mode=MODE,
        samples=SAMPLES,
    log:
        OUT / "logs" / "generate_summary.log",
    conda:
        ENV
    script:
        "scripts/generate_summary.py"

